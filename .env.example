PUBLIC_URL=https://tasks.example.com
TASKNOTES_DOMAIN=tasks.example.com
ALLOWED_GATEWAYS=https://push.example.com
# Comma-separated allowlist of your existing PushGo gateways.
ALLOW_HTTP_GATEWAYS=false
# Set true only for an HTTP gateway on your controlled network.
# This does not relax the public HTTPS requirement.
TASKNOTES_IMAGE=tasknotes-pushgo:0.1.0
# Or ghcr.io/your-owner/your-server-repository:latest after publishing from GitHub.
